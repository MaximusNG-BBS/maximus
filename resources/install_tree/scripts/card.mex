#include <max.mh>
#include <rand.mh>
#include <input.mh>
#include <prm.mh>
#include <swap.mh>
#include <maxui.mh>

// white \x0f
// yellow \x0e
// white on green \x2f
// red on green \x2c  (low intensity - \x24)
// black on green \x20

// A card consists of a number (face) and a suit (suit)

struct card
{
  char: face;
  char: suit;
};

struct hand
{
  array [1..52] of struct card: cards;
  int: n_cards;
};

// Hands for the deck of cards, the user, and the computer

struct hand: deck, user, comp;

// Number of times the user and computer has won

int: user_wins, comp_wins;
int: bankroll, current_bet, next_bet;
char: quit_game;
char: gfx_screen_loaded;
int: gfx_comp_hidden_cards;
int: result_fg_attr;
string: status_msg;
string: result_msg;

array [1..3] of string: score_names;
array [1..3] of int: score_cash;

#define START_BANKROLL 1000
#define MIN_BET          25

#define ACTION_STAND      0
#define ACTION_HIT        1
#define ACTION_QUIT       2
#define ACTION_BET        3
#define ACTION_DEAL       4

#define SCORE_FILE        "blackjack_scores.dat"
#define SCORE_ROWS        3
#define SCORE_COL         5
#define SCORE_WIDTH       14
#define SCORE_START_ROW  11

array [1..3] of string: hand_opts;
array [1..3] of string: round_opts;

int is_graphics();
void gfx_set_message(string: msg);
int sum_user_card();
int sum_comp_card();
void display_bankroll_status();


// Create a deck of cards.  Cards are numbered from 2 to 14, with
// 11-14 representing Jack, Queen, King and Ace (respectively).

void create_deck()
{
  int: i;

  i:=0;

  while (i < 52)
  {
    // Make sure that all cards are from 2-14

    deck.cards[i+1].face:=(i % 13)+2;

    // The suit is from 0-3


    deck.cards[i+1].suit:=((i / 13) % 4)+3;

    i:=i+1;
  }

  deck.n_cards:=52;
}




// Print out the deck of cards.  This prints out each cards' number and
// suit.

void print_deck()
{
  int: i;

  i:=1;

  while (i <= deck.n_cards)
  {
    print("Card #", i, ": deck=", (int)deck.cards[i].face,
          ", suit=", deck.cards[i].suit, "\n");

    i:=i+1;
  }
}


// Shuffle a deck of cards.  Take a created deck and place the cards in
// random order.

void shuffle_deck()
{
  int: i;
  int: c1, c2;

  i:=1;

  if (is_graphics())
    gfx_set_message("Shuffling the deck...");
  else
  {
    print(COL_LRED "Shuffling the deck...\n" COL_WHITE);
    vidsync();
  }

  while (i <= 100)
  {
    c1:=(rand() % 52)+1;
    c2:=(rand() % 52)+1;

    swapc(deck.cards[c1].face, deck.cards[c2].face);
    swapc(deck.cards[c1].suit, deck.cards[c2].suit);

    i:=i+1;
  }
}


// Calculate the sum of a hand of cards, taking aces into account.

int sum_cards(struct hand: hnd)
{
  int: aces, sum, n;

  sum:=0;
  aces:=0;
  n:=1;

  while (n <= 26 and n <= hnd.n_cards)
  {
//    print("Card #", n, " is `", (int)hnd.cards[n].face, "'.  Sum=", sum, '\n');

    if (hnd.cards[n].face <= 10)
      sum := sum + hnd.cards[n].face;
    else if (hnd.cards[n].face >= 11 and hnd.cards[n].face <= 13)
      sum := sum + 10;
    else if (hnd.cards[n].face=14)
      aces:=aces+11;
    else print("\aBug!  Unknown card type.\n");

    n:=n+1;
  }


  while (aces > 0)
  {
    if (sum+aces > 21)
    {
      if (aces > 10)
        aces := aces - 10;
      else
      {
        sum := sum + aces;
        aces := 0;
      }
    }
    else
    {
      sum:=sum+aces;
      aces := 0;
    }
  }
  
  return sum;
}


// Take a card off the top of the deck, and return its value

void deal_card(ref struct hand: h)
{
  // If we're out of cards, recreate the deck
    
  if (deck.n_cards=0)
  {
    create_deck();
    shuffle_deck();
  }
  
  h.n_cards:=h.n_cards+1;

  h.cards[h.n_cards].face:=deck.cards[deck.n_cards].face;
  h.cards[h.n_cards].suit:=deck.cards[deck.n_cards].suit;

  deck.n_cards:=deck.n_cards-1;
}


// Take a card from the deck and put it in the user's hand

void user_card()
{
  deal_card(user);
}


// Take a card from the deck and put it in the computer's hand

void comp_card()
{
  deal_card(comp);
}

int is_graphics()
{
  return (usr.video <> VIDEO_TTY);
}

int card_col(int: idx)
{
  return 24 + ((idx - 1) * 7);
}

string card_name(struct card: crd)
{
  string: temp, s;

  s:="";

  if (crd.face >= 2 and crd.face <= 10)
    s:=itostr(crd.face);
  else if (crd.face=11)
    s[1]:='J';
  else if (crd.face=12)
    s[1]:='Q';
  else if (crd.face=13)
    s[1]:='K';
  else if (crd.face=14)
    s[1]:='A';

  temp[1]:=crd.suit;
  s:=s+temp;

  if (s[3]=' ')
    s[3]:=' ';

  return s;
}

void gfx_clear_line(int: row, int: col, int: width)
{
  ui_fill_rect(row, col, width, 1, ' ', ui_make_attr(UI_WHITE, UI_BLACK));
}

void gfx_write_at(int: row, int: col, int: attr, string: s)
{
  ui_goto(row, col);
  ui_set_attr(attr);
  print(s);
}

void gfx_set_message(string: msg)
{
  if (strlen(msg) > 77)
    status_msg:=substr(msg, 1, 77);
  else
    status_msg:=msg;
}

void gfx_set_result(string: msg, int: fg_attr)
{
  result_msg:=msg;
  result_fg_attr:=fg_attr;
}

void gfx_clear_result()
{
  result_msg:="";
  result_fg_attr:=UI_WHITE;
}

int gfx_banner_col(string: msg)
{
  int: width, col;

  width:=strlen(msg);
  if (width >= 34)
    return 24;

  col:=24 + ((34 - width) / 2);
  if (col < 24)
    col:=24;

  return col;
}

void gfx_draw_status()
{
  gfx_clear_line(23, 2, 77);
  gfx_write_at(23, 2, ui_make_attr(UI_WHITE, UI_BLACK), status_msg);
}

void gfx_draw_result()
{
  int: attr, col, left_col, right_col;

  ui_fill_rect(19, 24, 34, 1, ' ', ui_make_attr(UI_WHITE, UI_GREEN));

  if (strlen(result_msg)=0)
    return;

  attr:=ui_make_attr(result_fg_attr, UI_GREEN);
  col:=gfx_banner_col(result_msg);
  left_col:=col-4;
  right_col:=col+strlen(result_msg)+1;

  if (left_col < 24)
    left_col:=24;
  if (right_col > 53)
    right_col:=53;

  gfx_write_at(19, left_col, ui_make_attr(UI_BLACK, UI_GREEN), ">>> ");
  gfx_write_at(19, col, attr, result_msg);
  gfx_write_at(19, right_col, ui_make_attr(UI_BLACK, UI_GREEN), " <<<");
}

string score_file()
{
  return prm_string(PRM_MEXDATAPATH) + SCORE_FILE;
}

void clear_scores()
{
  int: i;

  i:=1;
  while (i <= SCORE_ROWS)
  {
    score_names[i]:="";
    score_cash[i]:=0;
    i:=i+1;
  }
}

void insert_score(string: name, int: cash)
{
  int: i, j;

  if (cash < 0)
    return;

  i:=1;
  while (i <= SCORE_ROWS)
  {
    if (cash > score_cash[i] or strlen(score_names[i])=0)
    {
      j:=SCORE_ROWS;
      while (j > i)
      {
        score_names[j]:=score_names[j-1];
        score_cash[j]:=score_cash[j-1];
        j:=j-1;
      }

      score_names[i]:=name;
      score_cash[i]:=cash;
      return;
    }

    i:=i+1;
  }
}

void load_scores()
{
  int: fd, sep, cash;
  string: line, name, cash_s;

  clear_scores();

  fd:=open(score_file(), IOPEN_READ);
  if (fd=-1)
    return;

  while (readln(fd, line) <> -1)
  {
    sep:=stridx(line, 1, '|');
    if (sep > 0)
    {
      name:=substr(line, 1, sep-1);
      cash_s:=substr(line, sep+1, strlen(line)-sep);
      cash:=strtoi(cash_s);
      insert_score(name, cash);
    }
  }

  close(fd);
}

void save_scores()
{
  int: fd, i;

  fd:=open(score_file(), IOPEN_WRITE | IOPEN_CREATE);
  if (fd=-1)
    return;

  i:=1;
  while (i <= SCORE_ROWS)
  {
    if (strlen(score_names[i]) > 0)
      writeln(fd, score_names[i] + "|" + itostr(score_cash[i]));
    i:=i+1;
  }

  close(fd);
}

void update_scores()
{
  load_scores();
  insert_score(user_display_name(), bankroll);
  save_scores();
}

int played_any_hands()
{
  return (user_wins + comp_wins) > 0;
}

void gfx_draw_scores()
{
  int: i, row;
  string: name, cash;

  row:=SCORE_START_ROW;
  i:=1;

  while (i <= SCORE_ROWS)
  {
    ui_fill_rect(row, SCORE_COL, SCORE_WIDTH, 2, ' ', ui_make_attr(UI_BLACK, UI_CYAN));

    if (strlen(score_names[i]) > 0)
    {
      name:=score_names[i];
      if (strlen(name) > SCORE_WIDTH)
        name:=substr(name, 1, SCORE_WIDTH);

      cash:="`-- $" + itostr(score_cash[i]);
      if (strlen(cash) > SCORE_WIDTH)
        cash:=substr(cash, 1, SCORE_WIDTH);

      gfx_write_at(row, SCORE_COL, ui_make_attr(UI_WHITE, UI_CYAN), strpad(name, SCORE_WIDTH, ' '));
      gfx_write_at(row+1, SCORE_COL, ui_make_attr(UI_BLACK, UI_CYAN), strpad(cash, SCORE_WIDTH, ' '));
    }

    row:=row+2;
    i:=i+1;
  }
}

void gfx_draw_card(int: row, int: col, ref struct card: crd, int: hidden)
{
  int: border_attr, red_attr, black_attr;
  string: label;

  border_attr:=ui_make_attr(UI_BLACK, UI_GRAY);
  red_attr:=ui_make_attr(UI_RED, UI_GRAY);
  black_attr:=ui_make_attr(UI_BLACK, UI_GRAY);

  gfx_write_at(row,   col, border_attr, "\xDA\xC4\xC4\xC4\xC4\xBF");
  gfx_write_at(row+1, col, border_attr, "\xB3    \xB3");
  gfx_write_at(row+2, col, border_attr, "\xB3    \xB3");
  gfx_write_at(row+3, col, border_attr, "\xC0\xC4\xC4\xC4\xC4\xD9");

  if (hidden)
  {
    gfx_write_at(row+1, col+2, black_attr, "\xFA\xFA");
    gfx_write_at(row+2, col+2, black_attr, "\xFA\xFA");
    return;
  }

  label:=card_name(crd);

  if (crd.suit=5 or crd.suit=6)
    gfx_write_at(row+1, col+1, black_attr, label);
  else
    gfx_write_at(row+1, col+1, red_attr, label);
}

void gfx_draw_hand(ref struct hand: hnd, int: row, int: hide_card)
{
  int: i;

  ui_fill_rect(row, 24, 34, 4, ' ', ui_make_attr(UI_WHITE, UI_BLACK));

  i:=1;
  while (i <= 5)
  {
    if (i <= hnd.n_cards)
      gfx_draw_card(row, card_col(i), hnd.cards[i], i <= hide_card);

    i:=i+1;
  }
}

int gfx_hidden_comp_min()
{
  int: i, total;

  total:=0;
  i:=2;

  while (i <= comp.n_cards)
  {
    if (comp.cards[i].face <= 10)
      total:=total+comp.cards[i].face;
    else if (comp.cards[i].face <= 13)
      total:=total+10;
    else
      total:=total+11;

    i:=i+1;
  }

  return total;
}

int gfx_hidden_comp_max(int: lower)
{
  return lower + 11;
}

void gfx_draw_stats(int: hide_comp)
{
  int: visible_total, possible_total;

  gfx_write_at(14, 68, ui_make_attr(UI_WHITE, UI_CYAN), strpad(itostr(user_wins), 8, ' '));
  gfx_write_at(15, 68, ui_make_attr(UI_WHITE, UI_CYAN), strpad(itostr(comp_wins), 8, ' '));
  gfx_write_at(16, 68, ui_make_attr(UI_WHITE, UI_CYAN), strpad("$"+itostr(bankroll), 8, ' '));
  gfx_write_at(17, 68, ui_make_attr(UI_WHITE, UI_CYAN), strpad("$"+itostr(next_bet), 8, ' '));

  gfx_clear_line(9, 72, 6);
  gfx_clear_line(11, 70, 8);

  if (hide_comp)
  {
    visible_total:=gfx_hidden_comp_min();
    possible_total:=gfx_hidden_comp_max(visible_total);
    gfx_write_at(9, 72, ui_make_attr(UI_WHITE, UI_BLACK),
                 itostr(visible_total)+"-"+itostr(possible_total));
  }
  else
    gfx_write_at(9, 72, ui_make_attr(UI_WHITE, UI_BLACK), itostr(sum_comp_card()));

  gfx_write_at(11, 70, ui_make_attr(UI_WHITE, UI_BLACK), itostr(sum_user_card()));
}

void gfx_load_table()
{
  char: nonstop;

  reset_more(nonstop);
  print(AVATAR_CLS);
  display_file(prm_string(PRM_DISPLAYPATH) + "blackjack", nonstop);
  gfx_screen_loaded:=1;
}

void gfx_redraw_table(int: hide_comp)
{
  if (gfx_screen_loaded=0)
    gfx_load_table();

  gfx_comp_hidden_cards:=hide_comp;
  gfx_draw_hand(comp, 9, hide_comp);
  gfx_draw_hand(user, 14, 0);
  gfx_draw_scores();
  gfx_draw_stats(hide_comp);
  gfx_draw_result();
  gfx_draw_status();
}


// Display the name of a particular card

void __printSTRUCT_CARD(ref struct card: crd)
{
  string: temp, s;

  s:="";

  if (crd.face >= 2 and crd.face <= 10)
    s:=itostr(crd.face);
  else if (crd.face=11)
    s[1]:='J';
  else if (crd.face=12)
    s[1]:='Q';
  else if (crd.face=13)
    s[1]:='K';
  else if (crd.face=14)
    s[1]:='A';

  temp[1]:=crd.suit;
  s:=s+temp;

  if (s[3]=' ')
    s[3]:=' ';

  print(s);
}

void card_top(int: n_card)
{
  int: i;

  i:=1;
  
  while (i <= n_card)
  {
    print(COL_WHITEONGREEN "\xDA\xC4\xC4\xC4\xC4\xBF" COL_GRAY " ");
    i:=i+1;
  }

  print('\n');
}

void card_bot(int: n_card)
{
  int: i;

  i:=1;
  
  while (i <= n_card)
  {
    print(COL_WHITEONGREEN "\xC0\xC4\xC4\xC4\xC4\xD9" COL_GRAY " ");
    i:=i+1;
  }

  print('\n');
}

void card_mid(int: n_card)
{
  int: i;

  i:=1;
  
  while (i <= n_card)
  {
    print(COL_WHITEONGREEN "\xB3    \xB3" COL_GRAY " ");
    i:=i+1;
  }

  print('\n');
}


// Display a hand of cards on the screen

void display_cards(ref struct hand: hnd, int: hide_card)
{
  int: i;
//  string: cname;
  struct card: crd;
  
  card_top(hnd.n_cards);
  card_mid(hnd.n_cards);

  i:=1;

  while (i <= hnd.n_cards)
  {
    if (i <= hide_card)
      print(COL_WHITEONGREEN "\xB3 \xFA\xFA \xB3" COL_GRAY " ");
    else
    {
      // Pad the card's name to three characters

      print(COL_WHITEONGREEN "\xB3 ");

      if (hnd.cards[i].suit=5 or hnd.cards[i].suit=6)
        print(COL_BLACKONGREEN);
      else
        print(COL_REDONGREEN);

      print(hnd.cards[i], COL_WHITEONGREEN "\xB3" COL_GRAY " ");
    }

    i:=i+1;
  }

  print('\n');

  card_mid(hnd.n_cards);
  card_bot(hnd.n_cards);
  print("\n");
}


void display_user_card()
{
  if (is_graphics())
  {
    gfx_draw_hand(user, 14, 0);
    gfx_draw_stats(gfx_comp_hidden_cards);
    gfx_draw_status();
  }
  else
  {
    print(COL_YELLOW "\nYour cards:\n\n");
    display_cards(user, 0);
  }
}

void display_comp_card(int: hide)
{
  if (is_graphics())
  {
    gfx_comp_hidden_cards:=hide;
    gfx_draw_hand(comp, 9, hide);
    gfx_draw_stats(hide);
    gfx_draw_status();
  }
  else
  {
    print(COL_YELLOW "The computer's cards:\n\n");
    display_cards(comp, hide);
  }
}

void display_bankroll_status()
{
  if (is_graphics())
    gfx_draw_stats(gfx_comp_hidden_cards);
  else
    print(COL_LCYAN "Bankroll: $" COL_WHITE, bankroll,
          COL_LCYAN "   This hand: $" COL_WHITE, current_bet,
          COL_LCYAN "   Next hand: $" COL_WHITE, next_bet, "\n\n");
}


// Sum the cards currently in the user's hand

int sum_user_card()
{
  return (sum_cards(user));
}


// Sum the cards currently in the computer's hand

int sum_comp_card()
{
  return (sum_cards(comp));
}



// Check to see if the computer is over 21.

int check_comp_bust()
{
  return (sum_comp_card() > 21);
}


// Check to see if the user is over 21.

int check_user_bust()
{
  return (sum_user_card() > 21);
}



void wait_for_enter(string: msg)
{
  char: ch;

  if (is_graphics())
  {
    gfx_set_message(msg);
    gfx_draw_status();
    ui_fill_rect(21, 24, 34, 1, ' ', ui_make_attr(UI_WHITE, UI_BLACK));
    ui_goto(21, 24);
  }
  else
    print(COL_LCYAN, msg, COL_WHITE);

  ch:=getch();
  while (ch <> '\r' and ch <> '\n')
    ch:=getch();
}

int prompt_bet(int: allow_quit)
{
  string: bet_str;
  int: wager;

top:
  if (is_graphics())
  {
    gfx_draw_stats(gfx_comp_hidden_cards);
    ui_fill_rect(21, 24, 34, 1, ' ', ui_make_attr(UI_WHITE, UI_BLACK));
    ui_goto(21, 24);
    ui_set_attr(ui_make_attr(UI_WHITE, UI_BLACK));
    gfx_set_message("Enter bet. Minimum is $25.");
    gfx_draw_status();
  }
  else
  {
    print(COL_WHITE "Next bet [$", MIN_BET, " minimum");
    if (allow_quit)
      print(", Q quits");
    print("] <Enter keeps $", next_bet, ">: ");
  }

  input_str(bet_str, INPUT_NLB_LINE, 0, 10, "");

  if (is_graphics())
    gfx_draw_status();
  else
    print("\n");

  if (allow_quit and strlen(bet_str)=1 and
      (bet_str[1]='q' or bet_str[1]='Q'))
  {
    quit_game:=1;
    return 0;
  }

  if (strlen(bet_str)=0)
  {
    if (next_bet >= MIN_BET and next_bet <= bankroll)
      return next_bet;

    if (is_graphics())
    {
      gfx_set_message("You need a valid wager before the next hand.");
      gfx_draw_status();
    }
    else
      print(COL_LRED "You need a valid wager before the next hand.\n\n" COL_WHITE);
    goto top;
  }

  wager:=strtoi(bet_str);

  if (wager < MIN_BET)
  {
    if (is_graphics())
    {
      gfx_set_message("Minimum bet is $25.");
      gfx_draw_status();
    }
    else
      print(COL_LRED "Minimum bet is $", MIN_BET, ".\n\n" COL_WHITE);
    goto top;
  }

  if (wager > bankroll)
  {
    if (is_graphics())
    {
      gfx_set_message("You only have $" + itostr(bankroll) + ".");
      gfx_draw_status();
    }
    else
      print(COL_LRED "You only have $", bankroll, ".\n\n" COL_WHITE);
    goto top;
  }

  next_bet:=wager;

  if (is_graphics())
  {
    gfx_set_message("Next hand bet set to $" + itostr(next_bet) + ".");
    gfx_draw_status();
    gfx_draw_stats(gfx_comp_hidden_cards);
  }
  else
    print(COL_LGREEN "Next hand bet set to $" COL_WHITE, next_bet, ".\n\n");
  return next_bet;
}

int use_lightbar_prompt()
{
  return ((usr.video <> VIDEO_TTY) and cfg_bool("general.display.general.lightbar_prompts"));
}

int prompt_hand_action()
{
  char: opt;
  int: result;
  struct ui_select_prompt_style: sp_style;

  if (use_lightbar_prompt())
  {
    if (is_graphics())
    {
      gfx_set_message("Choose your move.");
      gfx_draw_status();
      ui_fill_rect(21, 24, 34, 1, ' ', ui_make_attr(UI_WHITE, UI_BLACK));
      ui_goto(21, 24);
    }

    ui_select_prompt_style_default(sp_style);
    sp_style.margin := 1;
    sp_style.separator := " / ";
    sp_style.prompt_attr := ui_mci2attr("|pr");
    sp_style.normal_attr := ui_mci2attr("|tx");
    sp_style.selected_attr := ui_make_attr(UI_WHITE, UI_CYAN);
    sp_style.hotkey_attr := ui_mci2attr("|hi");
    sp_style.show_brackets := UI_BRACKET_NONE;
    sp_style.default_index := 1;

    result := ui_select_prompt("Action ", hand_opts, 3, sp_style);

    if (result = 1)
      return ACTION_HIT;
    else if (result = 2)
      return ACTION_STAND;
    else
      return ACTION_QUIT;
  }

top:
  if (is_graphics())
  {
    ui_fill_rect(21, 24, 34, 1, ' ', ui_make_attr(UI_WHITE, UI_BLACK));
    ui_goto(21, 24);
    ui_set_attr(ui_make_attr(UI_WHITE, UI_BLACK));
    gfx_set_message("Hit, stand, or quit?");
    gfx_draw_status();
  }
  else
    print(COL_WHITE "H)it, S)tand, or Q)uit? ");

  opt:=getchp();

  if (is_graphics())
    gfx_draw_status();
  else
    print("\n\n");

  if (opt='s' or opt='S')
    return ACTION_STAND;
  else if (opt='h' or opt='H')
    return ACTION_HIT;
  else if (opt='q' or opt='Q')
    return ACTION_QUIT;
  else goto top;
}

int prompt_round_action()
{
  char: opt;
  int: result;
  struct ui_select_prompt_style: sp_style;

  display_bankroll_status();

  if (use_lightbar_prompt())
  {
    if (is_graphics())
    {
      gfx_set_message("Deal, adjust bet, or quit.");
      gfx_draw_status();
      ui_fill_rect(21, 24, 34, 1, ' ', ui_make_attr(UI_WHITE, UI_BLACK));
      ui_goto(21, 24);
    }

    ui_select_prompt_style_default(sp_style);
    sp_style.margin := 1;
    sp_style.separator := " / ";
    sp_style.prompt_attr := ui_mci2attr("|pr");
    sp_style.normal_attr := ui_mci2attr("|tx");
    sp_style.selected_attr := ui_make_attr(UI_WHITE, UI_CYAN);
    sp_style.hotkey_attr := ui_mci2attr("|hi");
    sp_style.show_brackets := UI_BRACKET_NONE;
    sp_style.default_index := 1;

    result := ui_select_prompt("Next move ", round_opts, 3, sp_style);

    if (result = 1)
      return ACTION_DEAL;
    else if (result = 2)
      return ACTION_BET;
    else
      return ACTION_QUIT;
  }

top:
  if (is_graphics())
  {
    ui_fill_rect(21, 24, 34, 1, ' ', ui_make_attr(UI_WHITE, UI_BLACK));
    ui_goto(21, 24);
    ui_set_attr(ui_make_attr(UI_WHITE, UI_BLACK));
    gfx_set_message("Deal, adjust bet, or quit.");
    gfx_draw_status();
  }
  else
    print(COL_WHITE "D)eal, B)et, or Q)uit? ");

  opt:=getchp();

  if (is_graphics())
    gfx_draw_status();
  else
    print("\n\n");

  if (opt='d' or opt='D' or opt='\r')
  {
    if (is_graphics())
    {
      gfx_clear_result();
      gfx_draw_result();
    }
    return ACTION_DEAL;
  }
  else if (opt='b' or opt='B')
  {
    if (is_graphics())
    {
      gfx_clear_result();
      gfx_draw_result();
    }
    return ACTION_BET;
  }
  else if (opt='q' or opt='Q')
    return ACTION_QUIT;
  else goto top;
}

// Get an option from the user.

int play_user_hand()
{
  int: action;

  if (check_user_bust())
    return 0;

top:
  display_bankroll_status();
  action:=prompt_hand_action();

  if (action=ACTION_STAND)
    return 0;
  else if (action=ACTION_QUIT)
  {
    quit_game:=1;
    return 0;
  }

  user_card();
  if (is_graphics())
    gfx_set_message("You take a hit.");
  display_user_card();

  return 1;
}

int play_comp_hand()
{
  if (sum_comp_card() < 16)
  {
    if (is_graphics())
      gfx_set_message("The computer takes a hit.");
    else
      print(COL_LRED "The computer takes a hit.\n");

    comp_card();
    display_comp_card(1);
  }
  else
  {
    if (is_graphics())
      gfx_set_message("The computer stays.");
    else
      print(COL_LRED "The computer stays.\n\n");
    return 0;
  }

  return 1;
}

void settle_hand_result()
{
  if (check_user_bust())
    bankroll:=bankroll-current_bet;
  else if (check_comp_bust())
    bankroll:=bankroll+current_bet;
  else if (sum_user_card() > sum_comp_card())
    bankroll:=bankroll+current_bet;
  else
    bankroll:=bankroll-current_bet;
}

// Play a hand of 21

int do_hand()
{
  user.n_cards:=0;
  comp.n_cards:=0;

  if (next_bet > bankroll)
    prompt_bet(FALSE);

  if (quit_game)
    return 0;

  current_bet:=next_bet;

  user_card();      // Deal two cards to each player
  comp_card();
  user_card();
  comp_card();

  if (is_graphics())
    gfx_set_message("Cards are on the table.");
  display_user_card();
  display_comp_card(1);

  while (play_user_hand() <> 0)
  {
    if (check_user_bust())
      goto done;
  }

  if (quit_game)
    return 0;

  while (play_comp_hand() <> 0)
  {
    if (check_comp_bust())
      goto done;
  }

done:
  if (is_graphics())
  {
    gfx_set_message("Final cards.");
    display_comp_card(0);
    display_user_card();
  }
  else
  {
    print(COL_YELLOWONBLUE AVATAR_CLEOL "Final cards:" COL_WHITE "\n");
    display_user_card();
    display_comp_card(0);
    print("\n");
  }

  settle_hand_result();

  if (check_user_bust())
  {
    if (is_graphics())
    {
      gfx_set_result("You busted", UI_LRED);
      gfx_set_message("You busted. The computer wins this hand.");
    }
    else
      print(COL_LRED "\aYou busted!  The computer wins.\n");
    comp_wins:=comp_wins+1;
  }
  else if (check_comp_bust())
  {
    if (is_graphics())
    {
      gfx_set_result("Dealer busted", UI_WHITE);
      gfx_set_message("The computer busted. You win this hand.");
    }
    else
      print(COL_LRED "\aThe computer busted!  You win.\n");
    user_wins:=user_wins+1;
  }
  else
  {
    if (sum_user_card() > sum_comp_card())
    {
      user_wins:=user_wins+1;
      if (is_graphics())
      {
        gfx_set_result("You won", UI_WHITE);
        gfx_set_message("You win this hand, " + itostr(sum_user_card()) +
                        " to " + itostr(sum_comp_card()) + ".");
      }
      else
      {
        print(COL_LGREEN "\nYour score was ", sum_user_card(), ".  ");
        print("The computer's score was ", sum_comp_card(), ".  ");
        print(COL_LRED AVATAR_BLINK "You win!" COL_GRAY "\n");
      }
    }
    else
    {
      comp_wins:=comp_wins+1;
      if (is_graphics())
      {
        gfx_set_result("You lost", UI_LRED);
        gfx_set_message("The computer wins this hand, " + itostr(sum_comp_card()) +
                        " to " + itostr(sum_user_card()) + ".");
      }
      else
      {
        print(COL_LGREEN "\nYour score was ", sum_user_card(), ".  ");
        print("The computer's score was ", sum_comp_card(), ".  ");
        print(COL_LRED AVATAR_BLINK "The computer wins!" COL_GRAY "\n");
      }
    }
  }

  display_bankroll_status();
  if (is_graphics())
  {
    gfx_draw_stats(0);
    gfx_draw_result();
    gfx_draw_status();
  }
  else
  {
    print(COL_YELLOW  "\nTotal wins:   ", user_wins, '\n');
    print(              "Total losses: ", comp_wins, "\n\n");
  }

  return 0;
}


void initialize()
{
  // Initialize the random number generator

  srand(time());

  // Set a few system variables

  user_wins:=0;
  comp_wins:=0;
  bankroll:=START_BANKROLL;
  current_bet:=MIN_BET;
  next_bet:=MIN_BET;
  quit_game:=0;
  gfx_screen_loaded:=0;
  gfx_comp_hidden_cards:=0;
  status_msg:="";
  result_msg:="";
  result_fg_attr:=UI_WHITE;
  hand_opts[1] := "[H]it";
  hand_opts[2] := "[S]tand";
  hand_opts[3] := "[Q]uit";
  round_opts[1] := "[D]eal";
  round_opts[2] := "[B]et";
  round_opts[3] := "[Q]uit";

  // Create the deck of cards, and do the initial shuffle.
    
  create_deck();
  shuffle_deck();
  load_scores();
}



int main()
{
  int: action;

  id.instant_video:=0;

  initialize();

  if (is_graphics())
  {
    gfx_set_message("You start with $1000, minimum bet is $25.");
    gfx_clear_result();
    gfx_redraw_table(1);
  }
  else
  {
    print(AVATAR_CLS COL_LGREEN "Max21 - \"BlackJack\" to the Max!\n");
    print("\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\xC4\n\n");
  }
  
  while (quit_game = 0 and bankroll >= MIN_BET)
  {
top:
    action:=prompt_round_action();

    if (action = ACTION_QUIT)
    {
      quit_game:=1;
      goto done;
    }
    else if (action = ACTION_BET)
    {
      prompt_bet(TRUE);
      if (quit_game)
        goto done;
      goto top;
    }

    do_hand();
  }

done:
  if (played_any_hands())
    update_scores();

  if (quit_game = 0 and bankroll < MIN_BET)
  {
    if (is_graphics())
      gfx_set_message("You're flatter than a sysop's cola after an all-night upload.");
    else
      print(COL_LRED "\aYou're flatter than a sysop's cola after an all-night upload.\n");
    wait_for_enter("<<Press Enter to slink away from the table>>");
    if (is_graphics() = 0)
      print("\n");
  }

  if (is_graphics())
  {
    gfx_set_message("Thanks for playing Max21!");
    gfx_draw_status();
  }
  else
    print(COL_LRED "Thanks for playing Max21!\n");

  return 0;
}
