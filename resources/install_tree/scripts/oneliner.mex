#include <max.mh>
#include <input.mh>
#include <prm.mh>
#include <maxui.mh>

// Configuration
#define MAX_LINES       12
#define NAME_WIDTH      15
#define MSG_WIDTH       58
#define DATA_FILE       "oneliners.dat"
#define COLOR_COUNT     15

// Display area (within borders)
#define MSG_START_ROW    8
#define MSG_END_ROW     18
#define MSG_START_COL    2
#define MSG_END_COL     77
#define CONTENT_WIDTH   75
#define PROMPT_ROW      21
#define PROMPT_COL      28
#define PROMPT_WIDTH    26
#define INPUT_ROW       22
#define INPUT_COL        3
#define INPUT_WIDTH     75

#define KEY_ESC          27
#define KEY_BACKSPACE     8

// Prompt lengths (for centering)
#define ENTER_PROMPT_LEN  25

// Storage for oneliners (array bounds must be literals)
array [1..12] of string: oneliners;
array [1..12] of string: authors;
int: count;

// Prompt/color state
array [1..2] of string: yesno;
array [1..15] of string: color_labels;
array [1..15] of string: color_codes;
int: current_color_idx;
char: input_cancelled;

void init_oneliner_ui()
{
  yesno[1] := "[Y]es";
  yesno[2] := "[N]o";

  color_labels[1] := "blue";
  color_labels[2] := "green";
  color_labels[3] := "cyan";
  color_labels[4] := "red";
  color_labels[5] := "magenta";
  color_labels[6] := "brown";
  color_labels[7] := "gray";
  color_labels[8] := "gray";
  color_labels[9] := "blue";
  color_labels[10] := "green";
  color_labels[11] := "cyan";
  color_labels[12] := "red";
  color_labels[13] := "magenta";
  color_labels[14] := "yellow";
  color_labels[15] := "white";

  color_codes[1] := "|01";
  color_codes[2] := "|02";
  color_codes[3] := "|03";
  color_codes[4] := "|04";
  color_codes[5] := "|05";
  color_codes[6] := "|06";
  color_codes[7] := "|07";
  color_codes[8] := "|08";
  color_codes[9] := "|09";
  color_codes[10] := "|10";
  color_codes[11] := "|11";
  color_codes[12] := "|12";
  color_codes[13] := "|13";
  color_codes[14] := "|14";
  color_codes[15] := "|15";
}

void clear_content_row(int: row)
{
  ui_fill_rect(row, MSG_START_COL, CONTENT_WIDTH, 1, ' ', ui_mci2attr("|tx"));
}

void clear_prompt_row()
{
  ui_fill_rect(PROMPT_ROW, MSG_START_COL, CONTENT_WIDTH, 1, ' ', ui_mci2attr("|tx"));
}

void clear_input_row()
{
  ui_fill_rect(INPUT_ROW, INPUT_COL, INPUT_WIDTH, 1, ' ', ui_mci2attr("|tx"));
}

void reset_prompt_area()
{
  clear_prompt_row();
  clear_input_row();
}

void draw_centered_prompt(string: color, string: msg)
{
  int: pad;

  clear_prompt_row();
  pad := (PROMPT_WIDTH - strlen(msg)) / 2;
  if (pad < 0)
    pad := 0;

  ui_goto(PROMPT_ROW, PROMPT_COL + pad);
  print(color + msg + "|cd");
}

// Load oneliners from file
void load_oneliners()
{
  int: fd;
  string: line;
  int: sep;

  count := 0;
  fd := open(prm_string(PRM_DISPLAYPATH) + DATA_FILE, IOPEN_READ);

  if (fd = -1)
    return;

  while (count < MAX_LINES and readln(fd, line) <> -1)
  {
    sep := stridx(line, 1, '|');
    if (sep > 0)
    {
      count := count + 1;
      authors[count] := substr(line, 1, sep - 1);
      oneliners[count] := substr(line, sep + 1, strlen(line) - sep);
    }
  }

  close(fd);
}

// Save oneliners to file
void save_oneliners()
{
  int: fd, i;

  fd := open(prm_string(PRM_DISPLAYPATH) + DATA_FILE, IOPEN_RW | IOPEN_CREATE);

  if (fd = -1)
  {
    print(COL_LRED + "Error: Could not save oneliners!" + COL_WHITE);
    return;
  }

  i := 1;
  while (i <= count)
  {
    writeln(fd, authors[i] + "|" + oneliners[i]);
    i := i + 1;
  }

  close(fd);
}

void render_message(string: msg)
{
  if (strlen(msg) > 0 and substr(msg, 1, 1) = "|")
    print(msg);
  else
    print("|tx" + msg + "|cd");
}

// Display oneliners on lines 8-18
void display_oneliners()
{
  int: i, row, namepad;
  string: dispname, dispmsg;

  i := 1;
  row := MSG_START_ROW;

  while (row <= MSG_END_ROW)
  {
    clear_content_row(row);
    ui_goto(row, MSG_START_COL);

    if (i <= count)
    {
      dispname := authors[i];
      if (strlen(dispname) > NAME_WIDTH)
        dispname := substr(dispname, 1, NAME_WIDTH);

      namepad := NAME_WIDTH - strlen(dispname);
      if (namepad < 0)
        namepad := 0;

      dispmsg := oneliners[i];
      if (strlen(dispmsg) > MSG_WIDTH)
      {
        if (substr(dispmsg, 1, 1) <> "|")
          dispmsg := substr(dispmsg, 1, MSG_WIDTH);
      }

      print("|dm" + strpad("", namepad, ' ') + "|hi" + dispname + "|pr: |cd");
      render_message(dispmsg);
    }

    i := i + 1;
    row := row + 1;
  }
}

void redraw_screen()
{
  char: nonstop;

  print(AVATAR_CLS);
  display_file(prm_string(PRM_DISPLAYPATH) + "oneliner", nonstop);
  display_oneliners();
}

int choose_add_message()
{
  int: result, key;
  int: use_lightbar_prompt;
  struct ui_select_prompt_style: sp_style;

  reset_prompt_area();
  use_lightbar_prompt := (usr.video <> VIDEO_TTY) and cfg_bool("general.display.general.lightbar_prompts");

  if (use_lightbar_prompt)
  {
    ui_select_prompt_style_default(sp_style);
    sp_style.margin := 1;
    sp_style.separator := " or ";
    sp_style.prompt_attr := ui_mci2attr("|pr");
    sp_style.normal_attr := ui_mci2attr("|tx");
    sp_style.selected_attr := ui_make_attr(UI_WHITE, UI_CYAN);
    sp_style.hotkey_attr := ui_mci2attr("|hi");
    sp_style.show_brackets := UI_BRACKET_NONE;
    sp_style.default_index := 1;

    ui_goto(PROMPT_ROW, PROMPT_COL);
    result := ui_select_prompt("Add message ", yesno, 2, sp_style);

    if (result = 1)
      return 1;

    return 0;
  }

  ui_goto(PROMPT_ROW, PROMPT_COL - 2);
  print("|prAdd message?|tx [Y/n] |cd");

  while (1)
  {
    key := ui_read_key();

    if (key = '\r' or key = '\n' or key = 'y' or key = 'Y')
      return 1;

    if (key = 'n' or key = 'N' or key = KEY_ESC)
      return 0;
  }
}

// Show centered press enter prompt and wait
void wait_for_enter(string: color, string: msg)
{
  int: key;

  clear_input_row();
  draw_centered_prompt(color, msg);

  key := ui_read_key();
  while (key <> '\r' and key <> '\n')
    key := ui_read_key();

  reset_prompt_area();
}

void draw_input_help()
{
  clear_prompt_row();
  ui_goto(PROMPT_ROW, MSG_START_COL + 2);

  if (usr.video = VIDEO_TTY)
    print("|prEnter saves your oneliner.|cd");
  else
    print("|prArrow keys change color, Enter saves, Esc cancels.|cd");
}

void draw_input_prompt(string: buf)
{
  clear_input_row();
  ui_goto(INPUT_ROW, INPUT_COL);

  if (usr.video = VIDEO_TTY)
  {
    print("|prSay what: |tx" + buf + "|cd");
    return;
  }

  print("|tx[");
  print(color_codes[current_color_idx] + color_labels[current_color_idx] + "|tx");
  print("] |prSay what: ");
  print(color_codes[current_color_idx] + buf + "|cd");
}

string read_graphical_oneliner()
{
  string: buf;
  int: key;

  buf := "";
  input_cancelled := 0;
  current_color_idx := 11;
  draw_input_help();

  while (1)
  {
    draw_input_prompt(buf);
    key := ui_read_key();

    if (key = '\r' or key = '\n')
      return buf;

    if (key = KEY_ESC)
    {
      input_cancelled := 1;
      return "";
    }

    if (key = UI_KEY_UP or key = UI_KEY_RIGHT)
    {
      current_color_idx := current_color_idx + 1;
      if (current_color_idx > COLOR_COUNT)
        current_color_idx := 1;
    }
    else if (key = UI_KEY_DOWN or key = UI_KEY_LEFT)
    {
      current_color_idx := current_color_idx - 1;
      if (current_color_idx < 1)
        current_color_idx := COLOR_COUNT;
    }
    else if (key = KEY_BACKSPACE or key = UI_KEY_DELETE or key = 127)
    {
      if (strlen(buf) > 1)
        buf := substr(buf, 1, strlen(buf) - 1);
      else if (strlen(buf) = 1)
        buf := "";
    }
    else if (key >= ' ' and key < 256)
    {
      if (strlen(buf) < MSG_WIDTH)
      {
        buf[strlen(buf) + 1] := key;
      }
    }
  }
}

string read_oneliner_text()
{
  string: buf;

  if (usr.video = VIDEO_TTY)
  {
    draw_input_help();
    clear_input_row();
    ui_goto(INPUT_ROW, INPUT_COL);
    input_str(buf, INPUT_NLB_LINE, 0, MSG_WIDTH, "Say what: ");
    input_cancelled := 0;
    return buf;
  }

  return read_graphical_oneliner();
}

string wrap_oneliner_color(string: raw)
{
  if (usr.video = VIDEO_TTY or strlen(raw) = 0)
    return raw;

  return color_codes[current_color_idx] + raw + "|cd";
}

string caller_name()
{
  string: author;

  if (strlen(usr.alias) > 0)
    author := usr.alias;
  else
    author := usr.name;

  if (strlen(author) > NAME_WIDTH)
    author := substr(author, 1, NAME_WIDTH);

  return author;
}

// Add a new oneliner
void add_oneliner()
{
  string: rawline, newline, author;
  int: i;

  author := caller_name();
  rawline := read_oneliner_text();

  if (input_cancelled or strlen(rawline) = 0)
  {
    if (input_cancelled)
      return;

    wait_for_enter("|wn", "<<Blank Oneliner Ignored>>");
    return;
  }

  newline := wrap_oneliner_color(rawline);

  // If at max, shift down (oldest rolls off)
  if (count >= MAX_LINES)
  {
    i := 1;
    while (i < MAX_LINES)
    {
      authors[i] := authors[i + 1];
      oneliners[i] := oneliners[i + 1];
      i := i + 1;
    }
    count := MAX_LINES - 1;
  }

  count := count + 1;
  authors[count] := author;
  oneliners[count] := newline;

  save_oneliners();
  log("Oneliner added by " + author + ": " + rawline);

  redraw_screen();
  wait_for_enter("|ok", "<<Saved - Press Enter>>");
}

// Main function
void main()
{
  init_oneliner_ui();
  load_oneliners();
  redraw_screen();

  if (choose_add_message())
    add_oneliner();
}
