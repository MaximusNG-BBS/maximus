    gfx_write_field(row, 21, 5, ui_make_attr(UI_MAGENTA, UI_BLACK), strpadleft(itostr(cached[i]), 5, ' '));
    i := i + 1;
    row := row + 1;
  }
}


void gfx_draw_triumph()
{
