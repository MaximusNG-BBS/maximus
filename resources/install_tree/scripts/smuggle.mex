  int: debt_state_attr, forum_state_attr, status_attr;
  string: debt_text, forum_text, rank_text, unlock_text;

  label_attr := ui_make_attr(UI_GRAY, UI_BLACK);
  value_attr := ui_make_attr(UI_YELLOW, UI_BLACK);
