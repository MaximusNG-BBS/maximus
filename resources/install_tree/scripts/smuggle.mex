char upper_key(char: ch)
{
  if (ch >= 'a' and ch <= 'z')
    return ch - 32;
  return ch;
}


void init_labels()
{
  goods[1] := "Falernian Wine";
  goods[2] := "Syrian Incense";
  goods[3] := "Poppy Resin";
  goods[4] := "Silk Bolts";
  goods[5] := "Forged Seals";
  goods[6] := "Legion Steel";

  districts[1] := "Forum District";
  districts[2] := "Subura";
  districts[3] := "Ostia Docks";
  districts[4] := "Aventine";
  districts[5] := "Campus Martius";
  districts[6] := "Palatine Shadows";
}


int carried_total()
{
  int: i, total;

  total := 0;
  i := 1;

  while (i <= GOODS_COUNT)
  {
    total := total + carried[i];
    i := i + 1;
  }

  return total;
}


int cached_total()
{
  int: i, total;

  total := 0;
  i := 1;

  while (i <= GOODS_COUNT)
  {
    total := total + cached[i];
    i := i + 1;
  }

  return total;
}


int free_capacity()
{
  return capacity_total - carried_total();
}


long net_worth()
{
  return purse + vault_balance - debt_to_varro;
}


int net_worth_negative()
{
  return (purse + vault_balance) < debt_to_varro;
}


long net_worth_abs()
{
  if (net_worth_negative())
    return debt_to_varro - (purse + vault_balance);

  return (purse + vault_balance) - debt_to_varro;
}


string net_worth_text()
{
  if (net_worth_negative())
    return "-" + ltostr(net_worth_abs());

  return ltostr(net_worth_abs());
}


string state_identity_key()
{
  string: src, out, part;
  int: i;
  char: ch;

  if (strlen(usr.name) > 0)
    src := strlower(usr.name);
  else
    src := strlower(user_display_name());

  out := "";
  i := 1;

  while (i <= strlen(src) and strlen(out) < 24)
  {
    ch := src[i];
    if ((ch >= 'a' and ch <= 'z') or (ch >= '0' and ch <= '9'))
      out := out + substr(src, i, 1);
    else if (ch = ' ' or ch = '-' or ch = '.' or ch = '_')
      out := out + "_";
    i := i + 1;
  }

  if (strlen(out) = 0)
    out := "caller";

  return out;
}


string state_file()
{
  return save_dir() + SAVE_PREFIX + state_identity_key() + ".dat";
}


string save_dir()
{
  return prm_string(PRM_MEXDATAPATH) + SAVE_DIR;
}


void clear_game_state_save()
{
  remove(state_file());
}


void sync_progress_state()
{
  if (guards < 0)
    guards := 0;

  if (capacity_total < 1)
    capacity_total := 1;

  if (net_worth() >= 600 or might_points >= 1 or guards > 0)
    unlock_sellswords := 1;

  if (debt_to_varro = 0 or net_worth() >= 1200 or prestige_points >= 2 or self_cart_count > 0)
    unlock_cartwright := 1;

  if (debt_to_varro = 0 and net_worth() >= 3500 and influence_points >= 3)
    unlock_warehouse := 1;

  if (debt_to_varro = 0 and net_worth() >= 5500 and influence_points >= 4)
    unlock_traders := 1;

  if (debt_to_varro = 0 and net_worth() >= 7000 and prestige_points >= 6)
    unlock_property := 1;

  trader_slots_unlocked := 1;
  if (unlock_traders and influence_points >= 5)
    trader_slots_unlocked := 2;
  if (unlock_traders and prestige_points >= 7)
    trader_slots_unlocked := 3;
  if (unlock_traders and prestige_points >= 9 and influence_points >= 7)
    trader_slots_unlocked := 4;

  if (self_sword_tier < SWORD_NONE)
    self_sword_tier := SWORD_NONE;
  if (self_armor_tier < ARMOR_NONE)
    self_armor_tier := ARMOR_NONE;
}


string triumph_rank_text()
{
  int: total;

  total := prestige_points + influence_points + might_points;

  if (total < 2)
    return "Street Runner";
  if (total < 5)
    return "Shadow Broker";
  if (total < 8)
    return "Forum Factor";
  if (total < 12)
    return "House Operator";
  if (total < 16)
    return "Night Magnate";
  if (total < 21)
    return "Patrician";

  return "Imperial Power";
}


string next_unlock_text()
{
  if (unlock_sellswords = 0)
    return "Sellswords";
  if (unlock_cartwright = 0)
    return "Cartwright";
  if (unlock_warehouse = 0)
    return "Warehouse";
  if (unlock_traders = 0)
    return "Trade Routes";
  if (unlock_property = 0)
    return "Estate Paths";
  if (triumph_ready())
    return "Retire in glory";

  return "Power paths";
}


int triumph_ready()
{
  return health > 0 and debt_to_varro <= 0 and net_worth() >= TRIUMPH_TARGET and current_district = 1;
}


string triumph_status_text()
{
  if (health <= 0)
    return "The grave keeps no triumph.";

  if (debt_to_varro > 0)
    return "Clear Varro's note first.";

  if (net_worth() < TRIUMPH_TARGET)
    return "Need " + ltostr(TRIUMPH_TARGET - net_worth()) + " more.";

  if (current_district <> 1)
    return "Return to the Forum.";

  return "Ready to retire in glory.";
}


long note_daily_fee()
{
  if (debt_to_varro <= 0)
    return 0;

  return 6 + (debt_to_varro / 200);
}


int home_services_available()
{
  return current_district = 1;
}


int district_watch_modifier()
{
  if (current_district = 2) return 3;
  if (current_district = 3) return 2;
  if (current_district = 5) return 1;
  if (current_district = 6) return 2;
  return 0;
}


long price_min(int: idx)
{
  if (idx = 1) return 12;
  if (idx = 2) return 35;
  if (idx = 3) return 24;
  if (idx = 4) return 90;
  if (idx = 5) return 70;
  if (idx = 6) return 120;

  return 10;
}


long price_span(int: idx)
{
  if (idx = 1) return 28;
  if (idx = 2) return 65;
  if (idx = 3) return 55;
  if (idx = 4) return 150;
  if (idx = 5) return 170;
  if (idx = 6) return 230;

  return 20;
}


int event_class_attr(int: cls)
{
  if (cls = EVENT_CLASS_GAIN)
    return ui_make_attr(UI_LGREEN, UI_BLACK);

  if (cls = EVENT_CLASS_WARNING)
    return ui_make_attr(UI_YELLOW, UI_BLACK);

  if (cls = EVENT_CLASS_DANGER)
    return ui_make_attr(UI_LRED, UI_BLACK);

  if (cls = EVENT_CLASS_THEFT)
    return ui_make_attr(UI_DKGRAY, UI_BLACK);

  return ui_make_attr(UI_WHITE, UI_BLACK);
}


void clear_event_buffer()
{
  int: i;

  event_msg_count := 0;
  i := 1;
  while (i <= EVENT_MSG_MAX)
  {
    event_msgs[i] := "";
    event_msg_classes[i] := EVENT_CLASS_INFO;
    i := i + 1;
  }
}


void push_event_message(int: cls, string: msg)
{
  int: i;

  if (strlen(msg) = 0)
    return;

  if (event_msg_count < EVENT_MSG_MAX)
    event_msg_count := event_msg_count + 1;
  else
  {
    i := 1;
    while (i < EVENT_MSG_MAX)
    {
      event_msgs[i] := event_msgs[i+1];
      event_msg_classes[i] := event_msg_classes[i+1];
      i := i + 1;
    }
  }

  event_msgs[event_msg_count] := msg;
  event_msg_classes[event_msg_count] := cls;
}


void set_event_class(int: cls, string: msg)
{
  last_event := msg;
  clear_event_buffer();
  push_event_message(cls, msg);
}


void clear_event()
{
  last_event := "";
  clear_event_buffer();
}


void append_event_class(int: cls, string: msg)
{
  if (strlen(msg) = 0)
    return;

  if (strlen(last_event) = 0)
    last_event := msg;
  else
    last_event := last_event + "\n" + msg;

  push_event_message(cls, msg);
}


void set_event(string: msg)
{
  set_event_class(EVENT_CLASS_INFO, msg);
}


void set_event_gain(string: msg)
{
  set_event_class(EVENT_CLASS_GAIN, msg);
}


void set_event_warning(string: msg)
{
  set_event_class(EVENT_CLASS_WARNING, msg);
}


void set_event_danger(string: msg)
{
  set_event_class(EVENT_CLASS_DANGER, msg);
}


void append_event(string: msg)
{
  append_event_class(EVENT_CLASS_INFO, msg);
}


void append_event_gain(string: msg)
{
  append_event_class(EVENT_CLASS_GAIN, msg);
}


void append_event_warning(string: msg)
{
  append_event_class(EVENT_CLASS_WARNING, msg);
}


void append_event_danger(string: msg)
{
  append_event_class(EVENT_CLASS_DANGER, msg);
}


void append_event_theft(string: msg)
{
  append_event_class(EVENT_CLASS_THEFT, msg);
}


string wrap_text_line(string: text, int: width)
{
  int: pos;
  string: token, line, out, rest;

  pos := 0;
  line := "";
  out := "";
  token := strtok(text, " ", pos);

  while (strlen(token) > 0)
  {
    while (strlen(token) > width)
    {
      if (strlen(line) > 0)
      {
        if (strlen(out) > 0)
          out := out + "\n";
        out := out + line;
        line := "";
      }

      if (strlen(out) > 0)
        out := out + "\n";
      out := out + substr(token, 1, width);
      rest := substr(token, width + 1, strlen(token) - width);
      token := rest;
    }

    if (strlen(line) = 0)
      line := token;
    else if (strlen(line) + 1 + strlen(token) <= width)
      line := line + " " + token;
    else
    {
      if (strlen(out) > 0)
        out := out + "\n";
      out := out + line;
      line := token;
    }

    token := strtok(text, " ", pos);
  }

  if (strlen(line) > 0)
  {
    if (strlen(out) > 0)
      out := out + "\n";
    out := out + line;
  }

  return out;
}


string wrap_event_text(string: text, int: width)
{
  int: pos;
  string: para, out, wrapped;

  pos := 0;
  out := "";
  para := strtok(text, "\n", pos);

  while (strlen(para) > 0)
  {
    wrapped := wrap_text_line(para, width);
    if (strlen(out) > 0)
      out := out + "\n";
    out := out + wrapped;
    para := strtok(text, "\n", pos);
  }

  return out;
}


string prompt_text_line(string: text)
{
  int: pos;
  string: token, out;

  pos := 0;
  out := "";
  token := strtok(text, " \n\r", pos);

  while (strlen(token) > 0)
  {
    if (strlen(out) > 0)
      out := out + " ";
    out := out + token;
    token := strtok(text, " \n\r", pos);
  }

  return out;
}


string score_file()
{
  return prm_string(PRM_MEXDATAPATH) + SCORE_FILE;
}


void save_game_state()
{
  int: fd, i;
  string: path, temp;

  sync_progress_state();

  path := state_file();
  temp := path + ".tmp";

  fd := open(temp, IOPEN_WRITE | IOPEN_CREATE);
  if (fd = -1)
    return;

  writeln(fd, "version|1");
  writeln(fd, "current_district|" + itostr(current_district));
  writeln(fd, "previous_district|" + itostr(previous_district));
  writeln(fd, "day_number|" + itostr(day_number));
  writeln(fd, "days_left_on_note|" + itostr(days_left_on_note));
  writeln(fd, "health|" + itostr(health));
  writeln(fd, "suspicion|" + itostr(suspicion));
  writeln(fd, "guards|" + itostr(guards));
  writeln(fd, "capacity_total|" + itostr(capacity_total));
  writeln(fd, "pending_resume_advance|" + itostr(pending_resume_advance));
  writeln(fd, "purse|" + ltostr(purse));
  writeln(fd, "vault_balance|" + ltostr(vault_balance));
  writeln(fd, "debt_to_varro|" + ltostr(debt_to_varro));
  writeln(fd, "last_trade_value|" + ltostr(last_trade_value));
  writeln(fd, "last_trade_volume|" + itostr(last_trade_volume));
  writeln(fd, "prestige_points|" + itostr(prestige_points));
  writeln(fd, "influence_points|" + itostr(influence_points));
  writeln(fd, "might_points|" + itostr(might_points));
  writeln(fd, "unlock_sellswords|" + itostr(unlock_sellswords));
  writeln(fd, "unlock_cartwright|" + itostr(unlock_cartwright));
  writeln(fd, "unlock_warehouse|" + itostr(unlock_warehouse));
  writeln(fd, "unlock_property|" + itostr(unlock_property));
  writeln(fd, "unlock_traders|" + itostr(unlock_traders));
  writeln(fd, "self_cart_count|" + itostr(self_cart_count));
  writeln(fd, "self_oxen_count|" + itostr(self_oxen_count));
  writeln(fd, "self_sword_tier|" + itostr(self_sword_tier));
  writeln(fd, "self_armor_tier|" + itostr(self_armor_tier));
  writeln(fd, "trader_slots_unlocked|" + itostr(trader_slots_unlocked));

  i := 1;
  while (i <= GOODS_COUNT)
  {
    writeln(fd, "price_" + itostr(i) + "|" + ltostr(prices[i]));
    writeln(fd, "carried_" + itostr(i) + "|" + itostr(carried[i]));
    writeln(fd, "cached_" + itostr(i) + "|" + itostr(cached[i]));
    i := i + 1;
  }

  i := 1;
  while (i <= TRADER_SLOTS)
  {
    writeln(fd, "trader_active_" + itostr(i) + "|" + itostr(trader_active[i]));
    writeln(fd, "trader_from_" + itostr(i) + "|" + itostr(trader_route_from[i]));
    writeln(fd, "trader_to_" + itostr(i) + "|" + itostr(trader_route_to[i]));
    writeln(fd, "trader_goods_" + itostr(i) + "|" + itostr(trader_goods_mask[i]));
    writeln(fd, "trader_cut_" + itostr(i) + "|" + itostr(trader_cut_pct[i]));
    writeln(fd, "trader_guards_" + itostr(i) + "|" + itostr(trader_guards[i]));
    writeln(fd, "trader_carts_" + itostr(i) + "|" + itostr(trader_carts[i]));
    writeln(fd, "trader_oxen_" + itostr(i) + "|" + itostr(trader_oxen[i]));
    writeln(fd, "trader_sword_" + itostr(i) + "|" + itostr(trader_sword_tier[i]));
    writeln(fd, "trader_armor_" + itostr(i) + "|" + itostr(trader_armor_tier[i]));
    i := i + 1;
  }

  close(fd);
  remove(path);
  rename(temp, path);
}


int load_game_state()
{
  int: fd, sep, idx, advanced_on_resume;
  string: line, key, value;

  fd := open(state_file(), IOPEN_READ);
  if (fd = -1)
    return 0;

  init_game();
  advanced_on_resume := 0;

  while (readln(fd, line) <> -1)
  {
    sep := stridx(line, 1, '|');
    if (sep > 0)
    {
      key := substr(line, 1, sep - 1);
      value := substr(line, sep + 1, strlen(line) - sep);

      if (key = "current_district") current_district := strtoi(value);
      else if (key = "previous_district") previous_district := strtoi(value);
      else if (key = "day_number") day_number := strtoi(value);
      else if (key = "days_left_on_note") days_left_on_note := strtoi(value);
      else if (key = "health") health := strtoi(value);
      else if (key = "suspicion") suspicion := strtoi(value);
      else if (key = "guards") guards := strtoi(value);
      else if (key = "capacity_total") capacity_total := strtoi(value);
      else if (key = "pending_resume_advance") pending_resume_advance := strtoi(value);
      else if (key = "purse") purse := strtol(value);
      else if (key = "vault_balance") vault_balance := strtol(value);
      else if (key = "debt_to_varro") debt_to_varro := strtol(value);
      else if (key = "last_trade_value") last_trade_value := strtol(value);
      else if (key = "last_trade_volume") last_trade_volume := strtoi(value);
      else if (key = "prestige_points") prestige_points := strtoi(value);
      else if (key = "influence_points") influence_points := strtoi(value);
      else if (key = "might_points") might_points := strtoi(value);
      else if (key = "unlock_sellswords") unlock_sellswords := strtoi(value);
      else if (key = "unlock_cartwright") unlock_cartwright := strtoi(value);
      else if (key = "unlock_warehouse") unlock_warehouse := strtoi(value);
      else if (key = "unlock_property") unlock_property := strtoi(value);
      else if (key = "unlock_traders") unlock_traders := strtoi(value);
      else if (key = "self_cart_count") self_cart_count := strtoi(value);
      else if (key = "self_oxen_count") self_oxen_count := strtoi(value);
      else if (key = "self_sword_tier") self_sword_tier := strtoi(value);
      else if (key = "self_armor_tier") self_armor_tier := strtoi(value);
      else if (key = "trader_slots_unlocked") trader_slots_unlocked := strtoi(value);
      else if (strfind(key, "price_") = 1)
      {
        idx := strtoi(substr(key, 7, strlen(key) - 6));
        if (idx >= 1 and idx <= GOODS_COUNT)
          prices[idx] := strtol(value);
      }
      else if (strfind(key, "carried_") = 1)
      {
        idx := strtoi(substr(key, 9, strlen(key) - 8));
        if (idx >= 1 and idx <= GOODS_COUNT)
          carried[idx] := strtoi(value);
      }
      else if (strfind(key, "cached_") = 1)
      {
        idx := strtoi(substr(key, 8, strlen(key) - 7));
        if (idx >= 1 and idx <= GOODS_COUNT)
          cached[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_active_") = 1)
      {
        idx := strtoi(substr(key, 14, strlen(key) - 13));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_active[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_from_") = 1)
      {
        idx := strtoi(substr(key, 13, strlen(key) - 12));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_route_from[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_to_") = 1)
      {
        idx := strtoi(substr(key, 11, strlen(key) - 10));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_route_to[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_goods_") = 1)
      {
        idx := strtoi(substr(key, 14, strlen(key) - 13));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_goods_mask[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_cut_") = 1)
      {
        idx := strtoi(substr(key, 12, strlen(key) - 11));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_cut_pct[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_guards_") = 1)
      {
        idx := strtoi(substr(key, 15, strlen(key) - 14));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_guards[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_carts_") = 1)
      {
        idx := strtoi(substr(key, 14, strlen(key) - 13));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_carts[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_oxen_") = 1)
      {
        idx := strtoi(substr(key, 13, strlen(key) - 12));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_oxen[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_sword_") = 1)
      {
        idx := strtoi(substr(key, 14, strlen(key) - 13));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_sword_tier[idx] := strtoi(value);
      }
      else if (strfind(key, "trader_armor_") = 1)
      {
        idx := strtoi(substr(key, 14, strlen(key) - 13));
        if (idx >= 1 and idx <= TRADER_SLOTS)
          trader_armor_tier[idx] := strtoi(value);
      }
    }
  }

  close(fd);

  if (pending_resume_advance)
  {
    clear_event();
    apply_turn_upkeep();
    if (game_over = 0)
    {
      randomize_market_prices();
      run_arrival_events();
    }
    pending_resume_advance := 0;
    advanced_on_resume := 1;
    save_game_state();
  }

  resumed_game := 1;
  quit_requested := 0;
  game_over := 0;
  retired := 0;
  sync_progress_state();
  if (advanced_on_resume)
    set_event_gain("You reopen your ledger where you left it. Rome kept moving, but your operation survived the night.");
  else
    set_event_gain("You reopen your ledger where you left it.");
  return 1;
}


int is_graphics()
{
  return (usr.video <> VIDEO_TTY);
}


void gfx_write_at(int: row, int: col, int: attr, string: s)
{
  if (strlen(s) > 0)
    ui_write_padded(row, col, strlen(s), s, attr);
}


void gfx_write_field(int: row, int: col, int: width, int: attr, string: s)
{
  ui_write_padded(row, col, width, s, attr);
}


void gfx_clear_rect(int: row, int: col, int: width, int: height, int: attr)
{
  ui_fill_rect(row, col, width, height, ' ', attr);
}


void gfx_fill_box(int: row, int: col, int: width, int: height, int: fill_attr, int: border_attr, string: title)
{
  if (width < 2 or height < 2)
    return;

  ui_fill_rect(row + 1, col + 1, width - 2, height - 2, ' ', fill_attr);
  ui_box(row, col, width, height, border_attr, title);
}


