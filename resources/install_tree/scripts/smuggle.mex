#define GOODS_COUNT       6
#define DISTRICT_COUNT    6

#define ACTION_NONE       0
#define ACTION_BUY        1
#define ACTION_SELL       2
#define ACTION_TRAVEL     3
#define ACTION_VAULT      4
#define ACTION_LENDER     5
#define ACTION_CACHE      6
#define ACTION_QUIT       7
#define ACTION_SCORES     8
#define ACTION_REDRAW     9
#define ACTION_SELLSWORDS 10
#define ACTION_CARTWRIGHT 11

#define SCORE_FILE        "smuggle_scores.dat"
#define SAVE_DIR          "smuggler-saves/"
#define SAVE_PREFIX       "smuggle_state_"
#define SCORE_ROWS        5
#define TRIUMPH_TARGET    10000
#define EVENT_MSG_MAX     12
#define TRADER_SLOTS      4

#define SWORD_NONE        0
#define SWORD_KNIFE       1
#define SWORD_GLADIUS     2
#define SWORD_SPATHA      3

#define ARMOR_NONE        0
#define ARMOR_LEATHER     1
#define ARMOR_MAIL        2
#define ARMOR_SCALE       3

#define EVENT_CLASS_INFO     1
#define EVENT_CLASS_GAIN     2
#define EVENT_CLASS_WARNING  3
#define EVENT_CLASS_DANGER   4
#define EVENT_CLASS_THEFT    5

