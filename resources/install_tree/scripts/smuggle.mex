  ready_attr := ui_make_attr(UI_LGREEN, UI_BLACK);

  gfx_clear_rect(20, 2, 28, 4, ui_make_attr(UI_WHITE, UI_BLACK));

  if (debt_to_varro > 0)
    debt_text := "Owes " + ltostr(debt_to_varro);
  else
    debt_text := "Clear";

  if (current_district = 1)
    forum_text := "Ready";
  else
    forum_text := "Away";

  rank_text := triumph_rank_text();
  unlock_text := next_unlock_text();

  if (debt_to_varro > 0)
    debt_state_attr := alert_attr;
  else
    debt_state_attr := ready_attr;

  if (current_district = 1)
    forum_state_attr := ready_attr;
  else
    forum_state_attr := value_attr;

  if (triumph_ready())
    status_attr := ready_attr;
  else
    status_attr := value_attr;

  gfx_write_field(20, 3, 26, label_attr, "Rank");
  gfx_write_field(20, 10, 19, value_attr, strpad(substr(rank_text, 1, 19), 19, ' '));
  gfx_write_field(21, 3, 26, label_attr, "Next");
  gfx_write_field(21, 10, 19, value_attr, strpad(substr(unlock_text, 1, 19), 19, ' '));
  gfx_write_field(22, 3, 12, label_attr, "Debt");
  gfx_write_field(22, 10, 8, debt_state_attr, strpad(substr(debt_text, 1, 8), 8, ' '));
  gfx_write_field(22, 19, 8, label_attr, "Forum");
  gfx_write_field(22, 25, 4, forum_state_attr, strpad(substr(forum_text, 1, 4), 4, ' '));
  gfx_write_field(23, 3, 26, status_attr,
                  strpad(substr(triumph_status_text(), 1, 26), 26, ' '));
}


void gfx_draw_event()
{
  int: row, pos, i, attr;
  string: wrapped, line;

  gfx_clear_rect(14, 32, 47, 11, ui_make_attr(UI_WHITE, UI_BLACK));

  row := 14;

  if (event_msg_count = 0)
  {
    wrapped := wrap_event_text(last_event, 47);
    pos := 0;
    line := strtok(wrapped, "\n", pos);
    while (row <= 24 and strlen(line) > 0)
    {
      gfx_write_field(row, 32, 47, ui_make_attr(UI_WHITE, UI_BLACK), line);
      row := row + 1;
      line := strtok(wrapped, "\n", pos);
    }
    return;
  }

  i := 1;
  while (i <= event_msg_count and row <= 24)
  {
    wrapped := wrap_text_line(event_msgs[i], 47);
    pos := 0;
    line := strtok(wrapped, "\n", pos);
    attr := event_class_attr(event_msg_classes[i]);

    while (row <= 24 and strlen(line) > 0)
    {
      gfx_write_field(row, 32, 47, attr, line);
      row := row + 1;
      line := strtok(wrapped, "\n", pos);
    }

    i := i + 1;
  }
}


