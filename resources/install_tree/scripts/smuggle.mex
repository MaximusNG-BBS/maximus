}


void gfx_restore_action_block(string: key)
{
  ui_puttext(key, 32, 9);
  ui_block_drop(key);
  ui_paint_region(32, 9, 78, 11);
}


int gfx_begin_modal(string: key, int: left, int: top, int: right, int: bottom)
{
  return ui_gettext(key, left, top, right, bottom);
}


void gfx_end_modal(string: key, int: left, int: top, int: right, int: bottom)
{
  ui_begin_update();
  ui_puttext(key, left, top);
  ui_paint_region(left, top, right, bottom);
  ui_end_update();
  ui_block_drop(key);
}


