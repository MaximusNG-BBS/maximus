void gfx_draw_market()
{
  int: i, row, price_attr;

  gfx_clear_rect(3, 2, 28, 6, ui_make_attr(UI_WHITE, UI_BLACK));
  i := 1;
  row := 3;
  while (i <= GOODS_COUNT)
  {
    gfx_write_field(row, 3, 18, ui_make_attr(UI_WHITE, UI_BLACK),
                    strpad(itostr(i) + ". " + goods[i], 18, ' '));

    if (prices[i] <= price_min(i) + (price_span(i) / 3))
      price_attr := ui_make_attr(UI_LGREEN, UI_BLACK);
    else if (prices[i] >= price_min(i) + ((price_span(i) * 2) / 3))
      price_attr := ui_make_attr(UI_YELLOW, UI_BLACK);
    else
      price_attr := ui_make_attr(UI_WHITE, UI_BLACK);

    gfx_write_field(row, 22, 7, price_attr, strpadleft(ltostr(prices[i]), 7, ' '));
    i := i + 1;
    row := row + 1;
  }
}


